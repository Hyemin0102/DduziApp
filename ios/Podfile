# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# 프로젝트가 static linkage를 쓰는데 RNFirebase는 기본적으로 SPM으로 Firebase SDK를
# 가져와서 static linkage랑 충돌함 (중복 심볼 에러). SPM 대신 CocoaPods로 받도록 전환
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'dduziApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Firebase의 Swift pod(FirebaseCoreInternal)가 GoogleUtilities에 의존하는데
  # GoogleUtilities가 모듈을 정의하지 않아서 static 링킹 시 필요.
  # use_modular_headers!를 전역으로 걸면 React Native 자체 pod(Hermes 등)까지
  # 영향을 받아 "Could not build module 'UIKit'" 같은 시스템 프레임워크 빌드
  # 에러가 cascade로 발생하므로, 필요한 pod에만 좁게 적용
  pod 'GoogleUtilities', :modular_headers => true

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # 🔥 모든 Pod에 대한 C++ 컴파일 설정
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # C++ 표준 설정
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        
        # 🔥 Folly 관련 플래그 (모든 타겟에 적용)
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= ['$(inherited)']
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-DFOLLY_NO_CONFIG'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-DFOLLY_MOBILE=1'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-DFOLLY_USE_LIBCPP=1'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-DFOLLY_CFG_NO_COROUTINES=1'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-DFOLLY_HAVE_CLOCK_GETTIME=1'
        
        # 🔥 경고를 에러로 처리하지 않음 (중요!)
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        
        # iOS 최소 버전
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end
    end
  end
end