diff --git a/node_modules/react-native-screens/ios/UIScrollView+RNScreens.mm b/node_modules/react-native-screens/ios/UIScrollView+RNScreens.mm
new file mode 100644
index 0000000..c877d5c
--- /dev/null
+++ b/node_modules/react-native-screens/ios/UIScrollView+RNScreens.mm
@@ -0,0 +1,15 @@
+#import "UIScrollView+RNScreens.h"
+
+@implementation UIScrollView (RNScreens)
+
+- (BOOL)rnscreens_scrollToTop
+{
+  if ([self contentOffset].y != -self.adjustedContentInset.top) {
+    [self setContentOffset:CGPointMake(0, -self.adjustedContentInset.top) animated:YES];
+    return YES;
+  }
+
+  return NO;
+}
+
+@end
